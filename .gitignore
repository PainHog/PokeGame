# Dependencies
node_modules/

# Generated Pokédex data (rebuild with `npm run build`)
# Source JSON is derived from @pkmn/data; compiled LevelDB packs are the runtime artifact.
src/packs/
packs/
# Generated map images (rebuilt by `npm run build`)
assets/maps/

# OS / editor
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/
.smoke-extract/

# Bundled sprites (fetched by `npm run sprites`, packaged into the release)
assets/sprites/

# Bundled trainer/NPC sprites (fetched by `npm run trainers`, packaged into the release)
assets/trainers/
